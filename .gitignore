# Godot
.godot/
game/.godot/
*.translation

# .NET
# Do not add [Dd]ebug/ or [Rr]elease/ here: bin/ and obj/ already cover build
# output, and those patterns would silently swallow source folders such as
# game/src/debug/.
bin/
obj/
*.user
*.suo

# Builds and tool output (build/ holds local code-review reports)
build/
builds/
*.pck
*.exe
*.app/
*.dmg
*.zip

# Source assets — NEVER in this repo (see LFS discipline)
*.blend
*.blend1
*.vox
*.aseprite
*.kra
raw_audio/

# Demo clips — kept outside the repo by D-22; docs/demos/ holds only the text
# index. Scoped to that one directory rather than a global *.mp4, so a future
# in-game video asset cannot be silently swallowed — see the [Dd]ebug/ note above
# for the same mistake made once already.
/docs/demos/*
!/docs/demos/README.md

# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# IDE
.vs/
.idea/
